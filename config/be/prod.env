# BE settings for production that are not secret. Reviewed in PRs like code.
# Secrets never go here: their names are in secrets.list, their values in Parameter Store.
APP_ENV=prod
LOG_LEVEL=info
APP_URL=https://api.example.com
DB_HOST=db.prod.internal
DB_NAME=ff_prod
DB_USERNAME=ff_app
REDIS_QUEUE_HOST=redis.prod.internal
