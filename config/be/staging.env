# BE settings for staging that are not secret. Reviewed in PRs like code.
# Secrets never go here: their names are in secrets.list, their values in Parameter Store.
APP_ENV=staging
LOG_LEVEL=debug
APP_URL=https://api.staging.example.com
DB_HOST=db.staging.internal
DB_NAME=ff_staging
DB_USERNAME=ff_app
REDIS_QUEUE_HOST=redis.staging.internal
